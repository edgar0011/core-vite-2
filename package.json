{
  "name": "core-vite-2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "vite",
    "dev:simple": "vite -- simple",
    "build": "tsc -b && vite build",
    "build:simple": "tsc -b && vite build -- simple",
    "build:ssl": "USE_SSL=true tsc -b && vite build",
    "build:simple:ssl": "USE_SSL=true tsc -b && vite build -- simple",
    "lint": "eslint src --ext js,jsx,ts,tsx",
    "lint:quiet": "yarn lint --quiet",
    "lint:fix": "yarn lint --fix",
    "preview": "vite preview",
    "start": "vite preview",
    "storybook": "storybook dev -p 6006",
    "plop": "plop",
    "tsc": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepush": "yarn lint && yarn tsc -b && yarn test:coverage",
    "validate": "yarn lint:fix && yarn tsc -b && yarn test:coverage ",
    "build-storybook": "storybook build",
    "build:be": "ts-node --esm esbuild-config.mts && cp -r src/server/cert distServer",
    "build:be:ssl": "ts-node --esm esbuild-config.ssl.mts && cp -r src/server/cert distServer",
    "dev:be": "NODE_ENV=development nodemon --watch './src/server/**/*' --ext 'mts,ts,js' --exec ts-node --esm -- ./src/server/index.mts",
    "dev:be:ssl": "NODE_ENV=development nodemon --watch './src/server/**/*' --ext 'mts,ts,js' --exec ts-node --esm -- ./src/server/index.ssl.mts",
    "start:be": "NODE_ENV=production node distServer/index.mjs",
    "start:prodbuild": "yarn build && yarn build:be && yarn start:be",
    "generate:ssl:cert": "bash src/server/generateSSLcert.sh",
    "docker:build": "docker build . -t edgar0011/core-vite-2-app",
    "docker:run": "docker run -p 8080:8080  edgar0011/core-vite-2-app",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@e1011/es-kit": "^1.1.84",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/themes": "^3.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "body-parser": "^2.2.2",
    "class-variance-authority": "^0.7.1",
    "compression": "^1.8.1",
    "connect-timeout": "^1.9.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-router": "^7.13.1",
    "tailwindcss": "^4.2.1",
    "vhost": "^3.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^9.39.3",
    "@storybook/addon-a11y": "^10.2.14",
    "@storybook/addon-docs": "^10.2.14",
    "@storybook/addon-onboarding": "^10.2.14",
    "@storybook/addon-vitest": "^10.2.14",
    "@storybook/react-vite": "^10.2.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/compression": "^1.8.1",
    "@types/connect-timeout": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/shelljs": "^0.10.0",
    "@types/vhost": "^3.0.10",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "clsx": "^2.1.1",
    "esbuild": "^0.27.4",
    "esbuild-node-externals": "^1.20.1",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "^10.2.14",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "nodemon": "^3.1.14",
    "playwright": "^1.58.2",
    "plop": "^4.0.5",
    "prettier": "^3.8.1",
    "prettier-plugin-packagejson": "^2.5.22",
    "prettier-plugin-sort-json": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sass-embedded": "^1.97.3",
    "shelljs": "^0.10.0",
    "storybook": "^10.2.14",
    "storybook-dark-mode": "^5.0.0",
    "tailwind-merge": "^3.5.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.3",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-replace": "^0.1.1",
    "vitest": "^4.0.18",
    "whatwg-fetch": "^3.6.20"
  }
}
