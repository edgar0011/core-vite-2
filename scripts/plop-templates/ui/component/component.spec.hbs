import { {{pascalCase name}} } from '~/components/{{module}}/{{kebabCase name}}'
import { fireEvent, render, screen } from '~/utils/test/test-utils'

describe('components/{{module}}/{{pascalCase name}}', () => {
  it('renders {{pascalCase name}} with default props', () => {
    const rendered = render(<{{pascalCase name}} />)

    expect(rendered?.container).toBeDefined()
    expect(screen.getByText('{{pascalCase name}} Title')).toBeInTheDocument()
    expect(screen.getByText('{{pascalCase name}} description text')).toBeInTheDocument()
    expect(screen.getByText('Action')).toBeInTheDocument()
  })

  it('renders {{pascalCase name}} with custom props', () => {
    const mockOnClick = vi.fn()

    render(
      <{{pascalCase name}}
        title="Custom Title"
        description="Custom description"
        buttonLabel="Custom Button"
        onButtonClick={mockOnClick}
        className="custom-class"
      />,
    )

    expect(screen.getByText('Custom Title')).toBeInTheDocument()
    expect(screen.getByText('Custom description')).toBeInTheDocument()
    expect(screen.getByText('Custom Button')).toBeInTheDocument()
  })

  it('calls onButtonClick when button is clicked', () => {
    const mockOnClick = vi.fn()

    render(<{{pascalCase name}} onButtonClick={mockOnClick} />)

    const buttons = screen.getAllByText('Action')
    const button = buttons[buttons.length - 1]

    fireEvent.click(button)

    expect(mockOnClick).toHaveBeenCalledTimes(1)
  })

  it('renders children when provided', () => {
    render(
      <{{pascalCase name}}>
        <div data-testid="custom-content">Custom content</div>
      </{{pascalCase name}}>,
    )

    expect(screen.getByTestId('custom-content')).toBeInTheDocument()
    expect(screen.getByText('Custom content')).toBeInTheDocument()
  })

  it('renders {{pascalCase name}} with classes', () => {
    const rendered = render(<{{pascalCase name}} className="anotherClass" />)

    const elements = rendered?.container.querySelectorAll('.anotherClass')

    const element = elements[0] as HTMLElement

    expect(rendered?.container).toBeDefined()
    expect(elements?.length).toEqual(1)
    expect(element?.getAttribute('class')?.includes('anotherClass')).toEqual(true)
  })
})
